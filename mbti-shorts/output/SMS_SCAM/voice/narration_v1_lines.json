[
 {
  "id": 1,
  "start": 0.0,
  "end": 2.63,
  "dur": 2.63,
  "text": "え、残高、ゼロ？"
 },
 {
  "id": 2,
  "start": 2.87,
  "end": 5.89,
  "dur": 3.02,
  "text": "話は、3分前に戻る。"
 },
 {
  "id": 3,
  "start": 6.49,
  "end": 10.45,
  "dur": 3.96,
  "text": "イヤホンを注文した夜、一通のSMSが届いた。"
 },
 {
  "id": 4,
  "start": 11.07,
  "end": 14.33,
  "dur": 3.26,
  "text": "お荷物をお預かりしています。再配達はこちら。"
 },
 {
  "id": 5,
  "start": 14.94,
  "end": 18.22,
  "dur": 3.28,
  "text": "あ、頼んでたやつだ。そう思って、リンクを押した。"
 },
 {
  "id": 6,
  "start": 18.56,
  "end": 22.5,
  "dur": 3.94,
  "text": "開いたのは、見慣れた宅配業者のサイト。"
 },
 {
  "id": 7,
  "start": 22.93,
  "end": 27.21,
  "dur": 4.28,
  "text": "本人確認だと言われて、電話番号と生年月日を入れた。"
 },
 {
  "id": 8,
  "start": 28.05,
  "end": 33.82,
  "dur": 5.77,
  "text": "同居人のリンが通りかかる。何やってんの。再配達の手続き、と俺は答えた。"
 },
 {
  "id": 9,
  "start": 34.21,
  "end": 43.28,
  "dur": 9.07,
  "text": "次の瞬間、銀行からSMSが届く。認証コード、六桁。絶対に他人に教えないでください。"
 },
 {
  "id": 10,
  "start": 44.0,
  "end": 47.31,
  "dur": 3.31,
  "text": "ここで、止まれるか。俺は、止まれなかった。"
 },
 {
  "id": 11,
  "start": 47.96,
  "end": 50.82,
  "dur": 2.86,
  "text": "コードを打ち込んで、確認。処理中の丸が、回る。"
 },
 {
  "id": 12,
  "start": 51.29,
  "end": 55.11,
  "dur": 3.82,
  "text": "同じ頃、知らない部屋で、誰かが実行を押した。"
 },
 {
  "id": 13,
  "start": 55.81,
  "end": 58.79,
  "dur": 2.98,
  "text": "通知が鳴る。29万8千円、送金完了。残高、ゼロ。"
 },
 {
  "id": 14,
  "start": 59.38,
  "end": 61.53,
  "dur": 2.15,
  "text": "リンが一言。銀行。今すぐ。"
 },
 {
  "id": 15,
  "start": 62.2,
  "end": 66.62,
  "dur": 4.42,
  "text": "番号を探せない俺からスマホを取り、アプリの緊急停止を押した。"
 },
 {
  "id": 16,
  "start": 67.09,
  "end": 69.09,
  "dur": 2.0,
  "text": "保留音の間に、やっと理解した。"
 },
 {
  "id": 17,
  "start": 69.55,
  "end": 74.21,
  "dur": 4.66,
  "text": "偽サイトに入れた番号で、詐欺師は本物の銀行にログインを試みる。"
 },
 {
  "id": 18,
  "start": 74.65,
  "end": 78.64,
  "dur": 3.99,
  "text": "銀行は、本人のスマホに認証コードを送る。"
 },
 {
  "id": 19,
  "start": 78.96,
  "end": 83.81,
  "dur": 4.85,
  "text": "それを偽サイトに打った瞬間、口座の鍵を、渡したことになる。"
 },
 {
  "id": 20,
  "start": 84.31,
  "end": 90.73,
  "dur": 6.42,
  "text": "電話がつながる。カードと口座、止めてください。送金の取消も。"
 },
 {
  "id": 21,
  "start": 91.26,
  "end": 93.65,
  "dur": 2.39,
  "text": "確認します。長い、数秒。"
 },
 {
  "id": 22,
  "start": 94.3,
  "end": 98.47,
  "dur": 4.17,
  "text": "知らない部屋のモニターが、赤く光った。送金失敗。受取口座、凍結。"
 },
 {
  "id": 23,
  "start": 99.4,
  "end": 100.52,
  "dur": 1.12,
  "text": "戻った。ギリギリで。"
 },
 {
  "id": 24,
  "start": 101.19,
  "end": 110.57,
  "dur": 9.38,
  "text": "リンが画面を指す。ジェイピーに、ドットトップ。宅配業者は、SMSでURLなんて送らない。"
 },
 {
  "id": 25,
  "start": 110.83,
  "end": 113.41,
  "dur": 2.58,
  "text": "押す前に、公式アプリ。"
 },
 {
  "id": 26,
  "start": 114.17,
  "end": 116.87,
  "dur": 2.7,
  "text": "翌日。ドアの下から、紙の不在票。"
 },
 {
  "id": 27,
  "start": 117.53,
  "end": 121.6,
  "dur": 4.07,
  "text": "本物は、紙で来た。"
 }
]